# BILLY WATER / SGF — configuração (copiar para config/config.properties ou colocar no classpath)
# Perfil: TESTE (H2 cifrada) ou REAL (PostgreSQL)
billywater.perfil=TESTE

# Perfil REAL (PostgreSQL)
real.bd.url=jdbc:postgresql://localhost:5432/billywater
real.bd.user=postgres
real.bd.password=

# Pasta de backups
pasta.backups=backups
