<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgv.desktop.CloseSessionFormController"
      spacing="0" styleClass="card-pane" prefWidth="500" prefHeight="400" stylesheets="@/styles/styles.css">

        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="card-header">
            <VBox spacing="4">
                <Label text="Fechar Caixa" styleClass="card-title"/>
                <Label text="Encerrar turno e declarar valores" styleClass="card-subtitle"/>
            </VBox>
        </HBox>

        <VBox spacing="20" styleClass="card-body">
            <Label fx:id="errorLabel" text="" styleClass="form-alert" managed="false" visible="false"/>

            <!-- System total -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="info-panel">
                <Label text="Total Calculado:" styleClass="form-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="expectedValueLabel" text="0.00" styleClass="status-card-value status-card-success"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-row">
                <Label text="Diferença:" styleClass="form-label"/>
                <Label fx:id="differenceLabel" text="0.00 MT" styleClass="difference-label"/>
            </HBox>

            <VBox spacing="6">
                <Label text="Valor Declarado / Contado *" styleClass="form-label"/>
                <TextField fx:id="reportedValueField" promptText="0.00" styleClass="form-input"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Observações / Justificação de Diferença" styleClass="form-label"/>
                <TextArea fx:id="notesArea" prefRowCount="3" promptText="Ex: Faltam 10 MT" styleClass="form-input"/>
            </VBox>

            <Separator styleClass="separator-light"/>
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button fx:id="cancelButton" text="Cancelar" styleClass="secondary-button"/>
                <StackPane>
                    <Button fx:id="saveButton" text="Confirmar Fecho" disable="true" styleClass="danger-button"/>
                    <ProgressIndicator fx:id="saveSpinner" visible="false" managed="false" styleClass="progress-indicator-white"/>
                </StackPane>
            </HBox>
        </VBox>
    </VBox>
