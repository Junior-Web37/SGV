<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgv.desktop.CloseSessionFormController"
      spacing="0" styleClass="card-pane" style="-fx-padding:0; -fx-background-radius:8; -fx-background-color:#ffffff;"
      prefWidth="500" prefHeight="400" stylesheets="@/styles/styles.css">

        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color:#0F172A; -fx-padding:16 24; -fx-border-color:#E2E8F0; -fx-border-width:0 0 1 0; -fx-background-radius:3 3 0 0;">
            <VBox spacing="4">
                <Label text="Fechar Caixa" style="-fx-font-size:17px; -fx-font-weight:600; -fx-text-fill:#ffffff;"/>
                <Label text="Encerrar turno e declarar valores"
                       style="-fx-font-size:12px; -fx-text-fill:#94A3B8;"/>
            </VBox>
        </HBox>

        <VBox spacing="20" style="-fx-padding:24; -fx-background-color:#ffffff; -fx-background-radius:0 0 3 3;">
            <Label fx:id="errorLabel" text=""
                   style="-fx-text-fill:#EF4444; -fx-font-size:13px; -fx-font-weight:600; -fx-background-color:#FEE2E2; -fx-background-radius:3; -fx-padding:8 12;"
                   managed="false" visible="false"/>

            <!-- System total -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color:#F8FAFC; -fx-padding:14; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-border-width:1;">
                <Label text="Total Calculado:"
                       style="-fx-text-fill:#475569; -fx-font-size:13px; -fx-font-weight:600;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="expectedValueLabel" text="0.00"
                       style="-fx-font-weight:700; -fx-font-size:18px; -fx-text-fill:#10B981;"/>
            </HBox>

            <VBox spacing="6">
                <Label text="Valor Declarado / Contado *"
                       style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                <TextField fx:id="reportedValueField" promptText="0.00"
                           style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:18px; -fx-font-weight:700; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Observações / Justificação de Diferença"
                       style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                <TextArea fx:id="notesArea" prefRowCount="3" promptText="Ex: Faltam 10 MT"
                          style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
            </VBox>

            <Separator style="-fx-opacity:0.2;"/>
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button fx:id="cancelButton" text="Cancelar" styleClass="btn-secondary-ux"
                        style="-fx-padding:8 16; -fx-font-size:13px; -fx-background-color:#ffffff; -fx-text-fill:#0F172A; -fx-background-radius:3; -fx-cursor:hand; -fx-font-weight:600; -fx-border-color:#E2E8F0; -fx-border-radius:3;"/>
                <StackPane>
                    <Button fx:id="saveButton" text="Confirmar Fecho" disable="true" styleClass="btn-primary-ux"
                            style="-fx-padding:8 16; -fx-font-size:13px; -fx-background-color:#EF4444; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:3; -fx-cursor:hand;"/>
                    <ProgressIndicator fx:id="saveSpinner" visible="false" managed="false"
                                       style="-fx-progress-color:white; -fx-max-width:20; -fx-max-height:20;"/>
                </StackPane>
            </HBox>
        </VBox>
    </VBox>
