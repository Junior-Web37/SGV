<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgv.desktop.ProductionOrderFormController"
      spacing="0" styleClass="card-pane" style="-fx-padding:0; -fx-background-radius:10; -fx-background-color:#ffffff;"
      prefWidth="780" prefHeight="650" stylesheets="@/styles/styles.css">

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: linear-gradient(to right, #1E3A8A, #1D4ED8, #1E40AF); -fx-padding:18 24; -fx-border-color:#1E293B; -fx-border-width:0 0 2 0; -fx-background-radius:10 10 0 0;">
            <VBox spacing="3">
                <Label text="🥖 Registo de Ordem de Produção &amp; Panificação" style="-fx-font-size:18px; -fx-font-weight:800; -fx-text-fill:#ffffff;"/>
                <Label text="Lançamento de produção de padaria, pastelaria e fabrico próprio com abate de matérias-primas" style="-fx-font-size:12px; -fx-text-fill:#94A3B8;"/>
            </VBox>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background:#ffffff; -fx-background-color:#ffffff;"
                    styleClass="edge-to-edge" hbarPolicy="NEVER">
            <VBox spacing="16" style="-fx-padding:24; -fx-background-color:#ffffff; -fx-background-radius:0 0 10 10;">
                <Label fx:id="errorLabel" text=""
                       style="-fx-text-fill:#EF4444; -fx-font-size:12px; -fx-font-weight:700; -fx-background-color:#FEE2E2; -fx-background-radius:6; -fx-padding:8 12; -fx-border-color:#FCA5A5; -fx-border-width:1; -fx-border-radius:6;"
                       visible="false" managed="false"/>

                <Label text="1. DADOS DA ORDEM DE PRODUÇÃO" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#2563EB;"/>
                <GridPane hgap="16" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>
                    <children>
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Nº da Ordem (Automático)" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                            <TextField fx:id="orderNumberField" disable="true"
                                       style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#F1F5F9; -fx-text-fill:#0F172A; -fx-opacity:0.75;"/>
                        </VBox>
                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Data de Fabrico / Registo *" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                            <DatePicker fx:id="registrationDatePicker"
                                        style="-fx-pref-width:1000; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-padding:3;"/>
                        </VBox>
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                            <Label text="Produto a Produzir (Padaria / Pastelaria) *" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                            <ComboBox fx:id="productCombo" promptText="Seleccione o artigo de panificação..."
                                      style="-fx-pref-width:1000; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#FFFFFF;"/>
                        </VBox>
                    </children>
                </GridPane>

                <Separator style="-fx-opacity:0.2;"/>

                <Label text="2. RENDIMENTO E QUANTIDADE" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#2563EB;"/>
                <GridPane hgap="16" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>
                    <children>
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Quantidade a Produzir *" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                            <TextField fx:id="quantityField" promptText="0"
                                       style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#10B981; -fx-border-radius:6; -fx-font-size:16px; -fx-font-weight:800; -fx-text-fill:#15803D; -fx-background-color:#FFFFFF;"/>
                        </VBox>
                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Unidade de Medida" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                            <ComboBox fx:id="unitCombo"
                                      style="-fx-pref-width:1000; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#FFFFFF;"/>
                        </VBox>
                    </children>
                </GridPane>

                <Separator style="-fx-opacity:0.2;"/>

                <!-- 3. TABELA DE MATÉRIAS-PRIMAS (BOM PREVIEW) -->
                <VBox spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="3. MATÉRIAS-PRIMAS A CONSUMIR (FICHA TÉCNICA / BOM)" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#2563EB;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="recipeStatusLabel" text="Selecione um produto para carregar a receita" style="-fx-font-size:11px; -fx-font-weight:700; -fx-text-fill:#64748B;"/>
                    </HBox>
                    <TableView fx:id="recipeTable" prefHeight="130" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="ingredientColumn" text="Matéria-Prima / Ingrediente" prefWidth="300"/>
                            <TableColumn fx:id="requiredColumn" text="Qtd. / Unidade" prefWidth="130"/>
                            <TableColumn fx:id="totalConsumedColumn" text="Total a Abater" prefWidth="140"/>
                            <TableColumn fx:id="unitColumn" text="Unidade" prefWidth="100"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <Separator style="-fx-opacity:0.2;"/>

                <Label text="4. RESPONSÁVEL E OBSERVAÇÕES" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#2563EB;"/>
                <VBox spacing="4">
                    <Label text="Padeiro Chefe / Responsável pelo Fabrico" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                    <ComboBox fx:id="responsibleCombo"
                              style="-fx-pref-width:1000; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#FFFFFF;"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Observações / Lote / Quebras de Fornada" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                    <TextArea fx:id="notesArea" prefRowCount="2" promptText="Ex: Temperatura do forno 220ºC, rendimento 100%..."
                              style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A;"/>
                </VBox>

                <Separator style="-fx-opacity:0.2;"/>
                <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding:8 0 0 0;">
                    <Button fx:id="cancelButton" text="Cancelar" styleClass="btn-secondary-ux"/>
                    <StackPane>
                        <Button fx:id="saveButton" text="✓ Salvar Ordem de Produção" styleClass="btn-primary-ux"/>
                        <ProgressIndicator fx:id="saveSpinner" visible="false" managed="false"
                                           style="-fx-progress-color:white; -fx-max-width:20; -fx-max-height:20;"/>
                    </StackPane>
                </HBox>
            </VBox>
        </ScrollPane>
    </VBox>
