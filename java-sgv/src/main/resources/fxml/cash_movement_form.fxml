<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgv.desktop.CashMovementFormController"
      spacing="0" styleClass="card-pane" style="-fx-padding:0; -fx-background-radius:10; -fx-background-color:#ffffff;"
      prefWidth="540" prefHeight="480" stylesheets="@/styles/styles.css">

        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: linear-gradient(to right, #1E3A8A, #1D4ED8, #1E40AF); -fx-padding:18 24; -fx-border-color:#1E293B; -fx-border-width:0 0 2 0; -fx-background-radius:10 10 0 0;">
            <VBox spacing="3">
                <Label text="💸 Movimento de Caixa (Sangria / Reforço)" style="-fx-font-size:18px; -fx-font-weight:800; -fx-text-fill:#ffffff;"/>
                <Label text="Registo de entrada ou saída física de dinheiro na sessão aberta" style="-fx-font-size:12px; -fx-text-fill:#94A3B8;"/>
            </VBox>
        </HBox>

        <VBox spacing="16" style="-fx-padding:24; -fx-background-color:#ffffff; -fx-background-radius:0 0 10 10;">
            <Label fx:id="errorLabel" text=""
                   style="-fx-text-fill:#EF4444; -fx-font-size:12px; -fx-font-weight:700; -fx-background-color:#FEE2E2; -fx-background-radius:6; -fx-padding:8 12; -fx-border-color:#FCA5A5; -fx-border-width:1; -fx-border-radius:6;"
                   managed="false" visible="false"/>

            <HBox spacing="14">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Tipo de Movimento *" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                    <ComboBox fx:id="typeCombo" style="-fx-pref-width:1000; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#FFFFFF;"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Motivo *" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                    <ComboBox fx:id="reasonCombo" style="-fx-pref-width:1000; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#FFFFFF;"/>
                </VBox>
            </HBox>

            <VBox spacing="4">
                <Label text="Valor (MT) *" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:13px;"/>
                <TextField fx:id="amountField" promptText="0.00"
                           style="-fx-padding:10 14; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:17px; -fx-font-weight:800; -fx-text-fill:#0F172A; -fx-background-color:#FFFFFF;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Descrição / Justificação *" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                <TextField fx:id="descriptionField" promptText="Ex: Sangria para depósito bancário / Pagamento de limpeza"
                           style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A;"/>
            </VBox>

            <Separator style="-fx-opacity:0.2;"/>
            <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding:8 0 0 0;">
                <Button fx:id="cancelButton" text="Cancelar" styleClass="btn-secondary-ux"/>
                <StackPane>
                    <Button fx:id="saveButton" text="✓ Registar Movimento" styleClass="btn-primary-ux"/>
                    <ProgressIndicator fx:id="saveSpinner" visible="false" managed="false"
                                       style="-fx-progress-color:white; -fx-max-width:20; -fx-max-height:20;"/>
                </StackPane>
            </HBox>
        </VBox>
    </VBox>
