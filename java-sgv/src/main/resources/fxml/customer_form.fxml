<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgv.desktop.CustomerFormController"
      spacing="0" styleClass="card-pane" style="-fx-padding:0; -fx-background-radius:10; -fx-background-color:#ffffff;"
      prefWidth="750" prefHeight="560" stylesheets="@/styles/styles.css">

        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: linear-gradient(to right, #1E3A8A, #1D4ED8, #1E40AF); -fx-padding:18 24; -fx-border-color:#1E293B; -fx-border-width:0 0 2 0; -fx-background-radius:10 10 0 0;">
            <VBox spacing="3">
                <Label text="Registo de Cliente" style="-fx-font-size:18px; -fx-font-weight:800; -fx-text-fill:#ffffff;"/>
                <Label text="Preencha os dados cadastrais, fiscais e comerciais do cliente" style="-fx-font-size:12px; -fx-text-fill:#94A3B8;"/>
            </VBox>
        </HBox>

        <VBox spacing="18" style="-fx-padding:24; -fx-background-color:#ffffff; -fx-background-radius:0 0 10 10;">
            <Label fx:id="errorLabel" text=""
                   style="-fx-text-fill:#EF4444; -fx-font-size:12px; -fx-font-weight:700; -fx-background-color:#FEE2E2; -fx-background-radius:6; -fx-padding:8 12; -fx-border-color:#FCA5A5; -fx-border-width:1; -fx-border-radius:6;"
                   visible="false" managed="false"/>

            <Label text="DADOS PESSOAIS / EMPRESA" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#2563EB;"/>
            <GridPane hgap="16" vgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <children>
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Código (Automático)" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                        <TextField fx:id="codeField" disable="true"
                                   style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#F1F5F9; -fx-text-fill:#0F172A; -fx-opacity:0.75;"/>
                    </VBox>
                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Tipo de Cliente *" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                        <ComboBox fx:id="typeCombo"
                                  style="-fx-pref-width:1000; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#FFFFFF;"/>
                    </VBox>
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                        <Label text="Nome Completo / Razão Social *" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                        <TextField fx:id="nameField" promptText="Ex: Distribuidora Central, Lda"
                                   style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A;"/>
                    </VBox>
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="BI / NUIT (9 dígitos)" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                        <TextField fx:id="nuitField" promptText="Ex: 400123456"
                                   style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A;"/>
                    </VBox>
                </children>
            </GridPane>

            <Label text="INFORMAÇÃO COMERCIAL" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#2563EB;"/>
            <GridPane hgap="16" vgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <children>
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Limite de Crédito (MT)" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                        <TextField fx:id="creditLimitField" promptText="0.00"
                                   style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A;"/>
                    </VBox>
                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Desconto Padrão (%)" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                        <TextField fx:id="defaultDiscountField" promptText="0.00"
                                   style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A;"/>
                    </VBox>
                </children>
            </GridPane>

            <Label text="DADOS DE CONTACTO &amp; LOCALIZAÇÃO" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#2563EB;"/>
            <GridPane hgap="16" vgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <children>
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Endereço / Morada" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                        <TextField fx:id="addressField" promptText="Ex: Av. 24 de Julho, Maputo"
                                   style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A;"/>
                    </VBox>
                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Contacto / Telefone" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                        <TextField fx:id="contactField" promptText="Ex: +258 84 123 4567"
                                   style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A;"/>
                    </VBox>
                </children>
            </GridPane>

            <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding:10 0 0 0;">
                <Button fx:id="deleteButton" text="Apagar Cliente" styleClass="btn-danger-ux"/>
                <Button fx:id="cancelButton" text="Cancelar" styleClass="btn-secondary-ux"/>
                <StackPane>
                    <Button fx:id="saveButton" text="Salvar Cliente" styleClass="btn-primary-ux"/>
                    <ProgressIndicator fx:id="saveSpinner" visible="false" managed="false"
                                       style="-fx-progress-color:white; -fx-max-width:20; -fx-max-height:20;"/>
                </StackPane>
            </HBox>
        </VBox>
    </VBox>
