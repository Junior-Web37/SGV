<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgv.desktop.ProductFormController"
      spacing="0" styleClass="card-pane" style="-fx-padding:0; -fx-background-radius:10; -fx-background-color:#ffffff;"
      prefWidth="900" prefHeight="730" stylesheets="@/styles/styles.css">

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: linear-gradient(to right, #1E3A8A, #1D4ED8, #1E40AF); -fx-padding:18 24; -fx-border-color:#1E293B; -fx-border-width:0 0 2 0; -fx-background-radius:10 10 0 0;">
            <VBox spacing="3">
                <Label text="🏷️ Ficha de Registo de Artigo / Produto" style="-fx-font-size:18px; -fx-font-weight:800; -fx-text-fill:#ffffff;"/>
                <Label text="Configuração de preços, tributação IVA/ICE, tabela de atacado e inventário" style="-fx-font-size:12px; -fx-text-fill:#94A3B8;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <CheckBox fx:id="activeCheck" text="Artigo Activo (Venda Permitida)" selected="true"
                      style="-fx-font-size:13px; -fx-text-fill:#ffffff; -fx-font-weight:700;"/>
        </HBox>

        <!-- CONTENT -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background:#ffffff; -fx-background-color:#ffffff;"
                    styleClass="edge-to-edge" hbarPolicy="NEVER">
            <VBox spacing="18" style="-fx-padding:24; -fx-background-color:#ffffff; -fx-background-radius:0 0 10 10;">
                
                <!-- ERRO -->
                <Label fx:id="errorLabel" text="" wrapText="true"
                       style="-fx-text-fill:#EF4444; -fx-font-size:12px; -fx-font-weight:700; -fx-background-color:#FEE2E2; -fx-background-radius:6; -fx-padding:8 12; -fx-border-color:#FCA5A5; -fx-border-width:1; -fx-border-radius:6;"
                       visible="false" managed="false"/>

                <!-- 1. DADOS GERAIS -->
                <VBox spacing="10">
                    <Label text="1. DADOS GERAIS DO ARTIGO" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#2563EB;"/>
                    <GridPane hgap="16" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33"/>
                            <ColumnConstraints percentWidth="34"/>
                            <ColumnConstraints percentWidth="33"/>
                        </columnConstraints>
                        <children>
                            <!-- Código -->
                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Código / SKU *" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="codeField" promptText="Ex: REF-0001"
                                           style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A;"/>
                                <Label text="Gerado automaticamente se vazio" style="-fx-font-size:10px; -fx-text-fill:#94A3B8;"/>
                            </VBox>
                            <!-- Nome -->
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.columnSpan="2">
                                <Label text="Nome / Descrição do Artigo *" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="nameField" promptText="Ex: Refrigerante Coca-Cola 330ml Lata"
                                           style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A;"/>
                            </VBox>
                            <!-- Categoria -->
                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Categoria / Família *" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <ComboBox fx:id="categoryCombo"
                                           style="-fx-pref-width:1000; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#FFFFFF;"/>
                            </VBox>
                            <!-- Fornecedor -->
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Fornecedor Principal" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <ComboBox fx:id="supplierCombo"
                                           style="-fx-pref-width:1000; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#FFFFFF;"/>
                            </VBox>
                            <!-- Serviço -->
                            <VBox alignment="CENTER_LEFT" spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="1"
                                  style="-fx-background-color:#F8FAFC; -fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#E2E8F0; -fx-border-width:1; -fx-border-radius:6;">
                                <CheckBox fx:id="isServiceCheckbox" text="É um Serviço / Não Físico"
                                          style="-fx-text-fill:#0F172A; -fx-font-size:12px; -fx-font-weight:700;"/>
                                <Label text="Serviços não movimentam inventário físico" style="-fx-text-fill:#94A3B8; -fx-font-size:10px;"/>
                            </VBox>
                        </children>
                    </GridPane>
                </VBox>

                <Separator style="-fx-opacity:0.2;"/>

                <!-- 2. PREÇOS E MARGEM (autocalculada) -->
                <VBox spacing="10">
                    <Label text="2. PREÇOS, MARGEM &amp; FISCALIDADE" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#2563EB;"/>
                    <GridPane hgap="16" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33"/>
                            <ColumnConstraints percentWidth="34"/>
                            <ColumnConstraints percentWidth="33"/>
                        </columnConstraints>
                        <children>
                            <!-- Preço Custo -->
                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Preço de Custo (MT)" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="priceCostField" promptText="0.00"
                                           style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A;"/>
                            </VBox>
                            <!-- Preço Venda -->
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Preço de Venda Retalho * (MT)" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="priceSaleField" promptText="0.00"
                                           style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#10B981; -fx-border-radius:6; -fx-font-size:14px; -fx-font-weight:800; -fx-background-color:#FFFFFF; -fx-text-fill:#15803D;"/>
                            </VBox>
                            <!-- Margem Lucro (autocalculada) -->
                            <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="Margem de Lucro Bruto (%)" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="profitMarginField" editable="false"
                                           style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#F1F5F9; -fx-text-fill:#64748B; -fx-font-weight:700;"/>
                                <Label text="Calculada automaticamente" style="-fx-font-size:10px; -fx-text-fill:#94A3B8;"/>
                            </VBox>
                            <!-- IVA (automático do sistema) -->
                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Taxa de IVA (%)" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="taxRateField" promptText="16"
                                           style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A;"/>
                                <Label fx:id="taxRateHint" text="16% Normal / 0% Isento (Art. 9 CIVA)" style="-fx-font-size:10px; -fx-text-fill:#94A3B8;"/>
                            </VBox>
                        </children>
                    </GridPane>
                </VBox>

                <Separator style="-fx-opacity:0.2;"/>

                <!-- 3. VENDA POR ATACADO -->
                <VBox fx:id="wholesaleSection" spacing="10">
                    <Label text="3. TABELA DE PREÇO POR GROSSO / ATACADO" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#2563EB;"/>
                    <GridPane hgap="16" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                        </columnConstraints>
                        <children>
                            <!-- Unidade Base -->
                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Unidade Base *" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <ComboBox fx:id="unitField"
                                           style="-fx-pref-width:1000; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#FFFFFF;"/>
                            </VBox>
                            <!-- Preço Atacado -->
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Preço Grosso (MT)" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="priceSaleBulkField" promptText="0.00"
                                           style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A;"/>
                            </VBox>
                            <!-- Qtd Mín Atacado -->
                            <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="Qtd Mínima Grosso" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="bulkQuantityField" text="1"
                                           style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A;"/>
                            </VBox>
                            <!-- Unid. Atacado -->
                            <VBox spacing="4" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                <Label text="Unidade Grosso" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <ComboBox fx:id="unitBulkField"
                                           style="-fx-pref-width:1000; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#FFFFFF;"/>
                            </VBox>
                            <!-- Factor Conversão -->
                            <VBox spacing="4" GridPane.columnIndex="4" GridPane.rowIndex="0">
                                <Label text="Fator Conversão" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="conversionFactorField" text="1.0"
                                           style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A;"/>
                            </VBox>
                        </children>
                    </GridPane>
                </VBox>

                <Separator style="-fx-opacity:0.2;"/>

                <!-- 4. CONTROLO DE STOCK -->
                <VBox fx:id="stockSection" spacing="10">
                    <Label text="4. LIMITES DE STOCK &amp; ALERTA DE REPOSIÇÃO" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#2563EB;"/>
                    <GridPane hgap="16" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <children>
                            <!-- Stock Mínimo -->
                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Stock Mínimo (Alerta de Reposição)" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="stockMinField" text="0"
                                           style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A;"/>
                                <Label text="Dispara notificação quando o stock da loja atingir este nível" style="-fx-font-size:10px; -fx-text-fill:#94A3B8;"/>
                            </VBox>
                            <!-- Stock Máximo -->
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Stock Máximo (Capacidade do Estabelecimento)" style="-fx-font-weight:700; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="stockMaxField" text="0"
                                           style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A;"/>
                                <Label text="Capacidade máxima física de armazenamento" style="-fx-font-size:10px; -fx-text-fill:#94A3B8;"/>
                            </VBox>
                        </children>
                    </GridPane>
                </VBox>

                <Separator style="-fx-opacity:0.2;"/>

                <!-- 5. CÓDIGOS DE BARRAS -->
                <VBox fx:id="barcodeSection" spacing="10">
                    <Label text="5. MÚLTIPLOS CÓDIGOS DE BARRAS (SCANNER USB)" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#2563EB;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="barcodeField" promptText="Digite ou faça scan do código de barras..."
                                   style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A; -fx-pref-width:320;"/>
                        <TextField fx:id="barcodeQtyField" text="1.0"
                                   style="-fx-pref-width:70; -fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A; -fx-alignment:center;"/>
                        <Label text="Qtd Multiplicadora" style="-fx-font-size:11px; -fx-text-fill:#475569; -fx-font-weight:700;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="addBarcodeButton" text="+ Adicionar Barcode" styleClass="btn-primary-ux"/>
                        <Button fx:id="removeBarcodeButton" text="Remover Selecionado" styleClass="btn-danger-ux"/>
                    </HBox>
                    <TableView fx:id="barcodeTable" prefHeight="130" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="barcodeCodeColumn" text="Código de Barras" prefWidth="350"/>
                            <TableColumn fx:id="barcodeQtyColumn" text="Qtd. por Embalagem" prefWidth="150"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <Separator style="-fx-opacity:0.2;"/>

                <!-- 6. DESCRIÇÃO -->
                <VBox spacing="6">
                    <Label text="6. OBSERVAÇÕES &amp; ESPECIFICAÇÕES COMPLEMENTARES" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#2563EB;"/>
                    <TextArea fx:id="descriptionArea" wrapText="true"
                              style="-fx-padding:8 12; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#FFFFFF; -fx-text-fill:#0F172A; -fx-min-height:60; -fx-max-height:90;"
                              promptText="Especificações adicionais, marca, lote ou instruções de armazenamento..."/>
                </VBox>

                <!-- BOTÕES -->
                <Separator style="-fx-opacity:0.2;"/>
                <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding:10 0 0 0;">
                    <Button fx:id="deleteButton" text="Apagar Produto" styleClass="btn-danger-ux"/>
                    <Button fx:id="cancelButton" text="Cancelar" styleClass="btn-secondary-ux"/>
                    <StackPane>
                        <Button fx:id="saveButton" text="Salvar Produto" styleClass="btn-primary-ux"/>
                        <ProgressIndicator fx:id="saveSpinner" visible="false" managed="false"
                                           style="-fx-progress-color:white; -fx-max-width:20; -fx-max-height:20;"/>
                    </StackPane>
                </HBox>
            </VBox>
        </ScrollPane>
    </VBox>
