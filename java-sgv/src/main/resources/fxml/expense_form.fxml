<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgv.desktop.ExpenseFormController"
      spacing="0" styleClass="card-pane" style="-fx-padding:0; -fx-background-radius:10; -fx-background-color:#ffffff;"
      prefWidth="780" prefHeight="580" stylesheets="@/styles/styles.css">

    <HBox alignment="CENTER_LEFT" spacing="14"
          style="-fx-background-color:#0F172A; -fx-padding:20 24; -fx-border-color:#E2E8F0; -fx-border-width:0 0 1 0; -fx-background-radius:10 10 0 0;">
        <VBox spacing="4">
            <Label text="Registo de Despesa Operacional (OPEX)" style="-fx-font-size:18px; -fx-font-weight:700; -fx-text-fill:#ffffff;"/>
            <Label text="Lançamento de custos operacionais, serviços, encargos e despesas por centro de custo" style="-fx-font-size:12px; -fx-text-fill:#94A3B8;"/>
        </VBox>
    </HBox>

    <VBox spacing="18" style="-fx-padding:24; -fx-background-color:#ffffff; -fx-background-radius:0 0 10 10;" VBox.vgrow="ALWAYS">
        <Label fx:id="errorLabel" text=""
               style="-fx-text-fill:#EF4444; -fx-font-size:13px; -fx-font-weight:600; -fx-background-color:#FEE2E2; -fx-background-radius:6; -fx-padding:8 12;"
               visible="false" managed="false"/>

        <Label text="DADOS DA DESPESA / GASTO OPERACIONAL" style="-fx-font-size:11px; -fx-font-weight:700; -fx-text-fill:#475569; -fx-font-family:monospace;"/>
        <GridPane hgap="16" vgap="14">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <children>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Descrição da Despesa *" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                    <TextField fx:id="descriptionField" promptText="Ex: Pagamento da factura EDM / Combustível carrinha"
                               style="-fx-padding:10 12; -fx-background-radius:6; -fx-border-color:#E2E8F0; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Categoria Contabilística (PGC MZ) *" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                    <ComboBox fx:id="categoryCombo" promptText="Seleccionar categoria..."
                              style="-fx-pref-width:1000; -fx-background-radius:6; -fx-border-color:#E2E8F0; -fx-border-radius:6; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#F8FAFC;"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Valor da Despesa (MT) *" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                    <TextField fx:id="amountField" promptText="0.00"
                               style="-fx-padding:10 14; -fx-background-radius:6; -fx-border-color:#2563EB; -fx-border-radius:6; -fx-font-size:20px; -fx-font-weight:800; -fx-text-fill:#2563EB; -fx-background-color:#F8FAFC;"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Nº Documento / Factura / Recibo" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                    <TextField fx:id="documentNumberField" promptText="Ex: REC-9821, FT 2026/088"
                               style="-fx-padding:10 12; -fx-background-radius:6; -fx-border-color:#E2E8F0; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                </VBox>
            </children>
        </GridPane>

        <Separator style="-fx-opacity:0.2;"/>

        <Label text="DATAS &amp; ESTADO DO PAGAMENTO" style="-fx-font-size:11px; -fx-font-weight:700; -fx-text-fill:#475569; -fx-font-family:monospace;"/>
        <GridPane hgap="16" vgap="14">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <children>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Data de Emissão / Registo *" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                    <DatePicker fx:id="expenseDatePicker"
                                style="-fx-pref-width:1000; -fx-background-radius:6; -fx-border-color:#E2E8F0; -fx-border-radius:6; -fx-font-size:13px; -fx-padding:3;"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Data de Vencimento" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                    <DatePicker fx:id="dueDateDatePicker"
                                style="-fx-pref-width:1000; -fx-background-radius:6; -fx-border-color:#E2E8F0; -fx-border-radius:6; -fx-font-size:13px; -fx-padding:3;"/>
                </VBox>
            </children>
        </GridPane>

        <Separator style="-fx-opacity:0.2;"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <CheckBox fx:id="isPaidCheckBox" text="Despesa já liquidada / paga (abater em caixa/tesouraria)" selected="true"
                      style="-fx-font-size:13px; -fx-text-fill:#0F172A; -fx-font-weight:600;"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>
        <Separator style="-fx-opacity:0.2;"/>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button fx:id="cancelButton" text="Cancelar" styleClass="btn-secondary-ux"
                    style="-fx-padding:9 18; -fx-font-size:13px; -fx-background-color:#ffffff; -fx-text-fill:#0F172A; -fx-background-radius:6; -fx-cursor:hand; -fx-font-weight:600; -fx-border-color:#E2E8F0; -fx-border-radius:6;"/>
            <StackPane>
                <Button fx:id="saveButton" text="Salvar Despesa" styleClass="btn-primary-ux"
                        style="-fx-padding:9 22; -fx-font-size:13px; -fx-background-color:#2563EB; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:6; -fx-cursor:hand;"/>
                <ProgressIndicator fx:id="saveSpinner" visible="false" managed="false"
                                   style="-fx-progress-color:white; -fx-max-width:22; -fx-max-height:22;"/>
            </StackPane>
        </HBox>
    </VBox>
</VBox>
