<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgv.desktop.CashMovementFormController"
      spacing="0" styleClass="card-pane" prefWidth="500" prefHeight="400" stylesheets="@/styles/styles.css">

        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="card-header">
            <VBox spacing="4">
                <Label text="Registar Movimento" styleClass="card-title"/>
                <Label text="Entrada ou Saída de Caixa" styleClass="card-subtitle"/>
            </VBox>
        </HBox>

        <VBox spacing="20" styleClass="card-body">
            <Label fx:id="errorLabel" text="" styleClass="form-alert" managed="false" visible="false"/>

            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="form-row">
                <Label text="Movimento de Caixa" styleClass="form-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="cashSessionHintLabel" text="Caixa aberto" styleClass="muted-label"/>
            </HBox>

            <VBox spacing="6">
                <Label text="Tipo de Movimento *" styleClass="form-label"/>
                <ComboBox fx:id="typeCombo" styleClass="form-input form-input-wide"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Motivo *" styleClass="form-label"/>
                <ComboBox fx:id="reasonCombo" styleClass="form-input form-input-wide"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Valor *" styleClass="form-label"/>
                <TextField fx:id="amountField" promptText="0.00" styleClass="form-input amount-input"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Descrição / Motivo *" styleClass="form-label"/>
                <TextField fx:id="descriptionField" promptText="Ex: Pagamento a fornecedor" styleClass="form-input"/>
            </VBox>

            <Separator styleClass="separator-light"/>
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button fx:id="cancelButton" text="Cancelar" styleClass="secondary-button"/>
                <StackPane>
                    <Button fx:id="saveButton" text="Registar" disable="true" styleClass="primary-button"/>
                    <ProgressIndicator fx:id="saveSpinner" visible="false" managed="false" styleClass="progress-indicator-white"/>
                </StackPane>
            </HBox>
        </VBox>
    </VBox>
