<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgv.desktop.CustomerFormController"
      spacing="0" styleClass="card-pane" style="-fx-padding:0; -fx-background-radius:8; -fx-background-color:#ffffff;"
      prefWidth="750" prefHeight="550" stylesheets="@/styles/styles.css">

        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color:#0F172A; -fx-padding:20 24; -fx-border-color:#E2E8F0; -fx-border-width:0 0 1 0; -fx-background-radius:3 3 0 0;">
            <VBox spacing="4">
                <Label text="Registo de Cliente" style="-fx-font-size:18px; -fx-font-weight:600; -fx-text-fill:#ffffff;"/>
                <Label text="Preencha os dados do cliente" style="-fx-font-size:12px; -fx-text-fill:#94A3B8;"/>
            </VBox>
        </HBox>

        <VBox spacing="20" style="-fx-padding:24; -fx-background-color:#ffffff; -fx-background-radius:0 0 3 3;">
            <Label fx:id="errorLabel" text=""
                   style="-fx-text-fill:#EF4444; -fx-font-size:13px; -fx-font-weight:600; -fx-background-color:#FEE2E2; -fx-background-radius:3; -fx-padding:8 12;"
                   visible="false" managed="false"/>

            <Label text="DADOS PESSOAIS / EMPRESA" style="-fx-font-size:11px; -fx-font-weight:700; -fx-text-fill:#64748B;"/>
            <GridPane hgap="16" vgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <children>
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Código (Automático)" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                        <TextField fx:id="codeField" disable="true"
                                   style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A; -fx-opacity:0.6;"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Tipo de Cliente" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                        <ComboBox fx:id="typeCombo"
                                  style="-fx-pref-width:1000; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#F8FAFC;"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                        <Label text="Nome Completo / Razão Social *" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                        <TextField fx:id="nameField"
                                   style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="BI / NUIT *" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                        <TextField fx:id="nuitField"
                                   style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                    </VBox>
                </children>
            </GridPane>

            <Label text="INFORMAÇÃO COMERCIAL" style="-fx-font-size:11px; -fx-font-weight:700; -fx-text-fill:#64748B;"/>
            <GridPane hgap="16" vgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <children>
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Limite de Crédito" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                        <TextField fx:id="creditLimitField"
                                   style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Desconto Padrão (%)" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                        <TextField fx:id="defaultDiscountField"
                                   style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                    </VBox>
                </children>
            </GridPane>

            <Label text="DADOS DE CONTACTO" style="-fx-font-size:11px; -fx-font-weight:700; -fx-text-fill:#64748B;"/>
            <GridPane hgap="16" vgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <children>
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Endereço" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                        <TextField fx:id="addressField"
                                   style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Contacto / Telefone" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                        <TextField fx:id="contactField"
                                   style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                    </VBox>
                </children>
            </GridPane>


            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button fx:id="deleteButton" text="Apagar Cliente"
                        style="-fx-padding:8 16; -fx-font-size:13px; -fx-background-color:#DC2626; -fx-text-fill:white; -fx-background-radius:3; -fx-cursor:hand; -fx-font-weight:600;"/>
                <Button fx:id="cancelButton" text="Cancelar" styleClass="btn-secondary-ux"
                        style="-fx-padding:8 16; -fx-font-size:13px; -fx-background-color:#ffffff; -fx-text-fill:#0F172A; -fx-background-radius:3; -fx-cursor:hand; -fx-font-weight:600; -fx-border-color:#E2E8F0; -fx-border-radius:3;"/>
                <StackPane>
                    <Button fx:id="saveButton" text="Salvar Cliente" styleClass="btn-primary-ux"
                            style="-fx-padding:8 16; -fx-font-size:13px; -fx-background-color:#2563EB; -fx-text-fill:white; -fx-font-weight:600; -fx-background-radius:3; -fx-cursor:hand;"/>
                    <ProgressIndicator fx:id="saveSpinner" visible="false" managed="false"
                                       style="-fx-progress-color:white; -fx-max-width:20; -fx-max-height:20;"/>
                </StackPane>
            </HBox>
        </VBox>
    </VBox>
