<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgv.desktop.OpenSessionFormController"
      spacing="0" styleClass="card-pane" prefWidth="500" prefHeight="350" stylesheets="@/styles/styles.css">

        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="card-header">
            <VBox spacing="4">
                <Label text="Abrir Caixa" styleClass="card-title"/>
                <Label text="Iniciar novo turno" styleClass="card-subtitle"/>
            </VBox>
        </HBox>

        <VBox spacing="18" styleClass="card-body">
            <HBox spacing="24">
                <VBox spacing="6">
                    <Label text="Operador" styleClass="form-label"/>
                    <Label fx:id="operatorLabel" text="-" styleClass="form-field-strong"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Filial" styleClass="form-label"/>
                    <Label fx:id="branchLabel" text="-" styleClass="form-field-strong"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <Label fx:id="errorLabel" text="" styleClass="form-alert" managed="false" visible="false"/>

            <VBox spacing="6">
                <Label text="Valor Inicial em Caixa *" styleClass="form-label"/>
                <TextField fx:id="initialValueField" promptText="0.00" styleClass="form-input"/>
            </VBox>

            <Separator styleClass="separator-light"/>
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button fx:id="cancelButton" text="Cancelar" styleClass="secondary-button"/>
                <StackPane>
                    <Button fx:id="saveButton" text="Abrir Caixa" disable="true" styleClass="primary-button-success"/>
                    <ProgressIndicator fx:id="saveSpinner" visible="false" managed="false" styleClass="progress-indicator-white"/>
                </StackPane>
            </HBox>
        </VBox>
    </VBox>
