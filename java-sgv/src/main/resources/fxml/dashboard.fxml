<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Pos?>
    <BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
             fx:controller="com.sgv.desktop.DashboardController"
             fx:id="dashboardRoot"
             style="-fx-background-color:#F8FAFC;">

        <!-- ══════════════════════════════════════════════
         TOP NAVIGATION BAR (PROFISSIONAL & ESTRUTURADO)
         ══════════════════════════════════════════════ -->
    <top>
        <VBox fx:id="topContainer" styleClass="top-nav-bar" style="-fx-background-color: linear-gradient(to right, #1E3A8A, #1D4ED8, #1E40AF); -fx-border-color: #172554; -fx-border-width: 0 0 2 0;">

            <!-- Brand + Nav + User Row -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-padding: 0 16; -fx-min-height: 58; -fx-pref-height: 58; -fx-max-height: 58;">

                <!-- Brand Card with Border -->
                <HBox spacing="8" alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(0, 0, 0, 0.25); -fx-border-color: rgba(255, 255, 255, 0.20); -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 6 12;">
                    <Label text="⚡" style="-fx-font-size: 15px; -fx-text-fill: #60A5FA;"/>
                    <Label text="SGV" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #FFFFFF; -fx-font-family: 'Segoe UI', Arial, sans-serif;"/>
                    <Label text="PRO" style="-fx-font-size: 9px; -fx-font-weight: 800; -fx-text-fill: #93C5FD; -fx-background-color: rgba(59, 130, 246, 0.35); -fx-background-radius: 4; -fx-padding: 1 5; -fx-border-color: rgba(147, 197, 253, 0.4); -fx-border-radius: 4;"/>
                </HBox>

                <Separator orientation="VERTICAL" style="-fx-padding: 8 2; -fx-opacity: 0.35;"/>

                <!-- Navigation Segmented Container -->
                <StackPane fx:id="navStackPane"
                           style="-fx-background-color: rgba(0, 0, 0, 0.20); -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 3 4;">

                    <!-- ROOT NAV: Módulos Reorganizados por Fluxo de Negócio Lógico -->
                    <HBox fx:id="navRootPane" spacing="4" alignment="CENTER_LEFT">
                        <Button fx:id="navResumo" text="⌂ Painel" styleClass="nav-btn-home"/>
                        <Button fx:id="navModComercial" text="Vendas ▾" styleClass="nav-btn"/>
                        <Button fx:id="navModFinanceiro" text="Caixa ▾" styleClass="nav-btn"/>
                        <Button fx:id="navModOperacoes" text="Stock ▾" styleClass="nav-btn"/>
                        <Button fx:id="navModArmazens" text="Armazém ▾" styleClass="nav-btn"/>
                        <Button fx:id="navModRelatorios" text="Relatórios ▾" styleClass="nav-btn"/>
                        <Button fx:id="navModAdministracao" text="Configurações ▾" styleClass="nav-btn"/>
                        <Button fx:id="navLogsRoot" text="🛡️ Logs" styleClass="nav-btn"/>
                    </HBox>

                    <!-- SUB-MODULE NAV -->
                    <HBox fx:id="navSubPane" spacing="4" alignment="CENTER_LEFT" visible="false" managed="false">
                        <Button fx:id="navBackButton" text="◂ Voltar" styleClass="nav-btn-back"/>
                        <Separator orientation="VERTICAL" style="-fx-padding: 6 2; -fx-opacity: 0.35;"/>
                        <Label fx:id="navSubModuleLabel" text="Vendas &amp; Facturação"
                               style="-fx-text-fill: #93C5FD; -fx-font-size: 11px; -fx-font-weight: 800; -fx-background-color: rgba(59, 130, 246, 0.25); -fx-border-color: rgba(147, 197, 253, 0.4); -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 4 8;"/>

                        <!-- 1. Vendas & Facturação: PDV | Cotações | Facturas | Clientes -->
                        <HBox fx:id="navComercialItems" spacing="4" alignment="CENTER_LEFT">
                            <Button fx:id="navMenuNovaVenda" text="⚡ PDV / Venda" styleClass="nav-btn"/>
                            <Button fx:id="navMenuVendas"    text="📄 Facturas &amp; Vendas" styleClass="nav-btn"/>
                            <Button fx:id="navMenuClientes"  text="👥 Clientes" styleClass="nav-btn"/>
                        </HBox>

                        <!-- 2. Caixa & Tesouraria: Caixa | Recebimentos | Despesas | Resumo -->
                        <HBox fx:id="navFinanceiroItems" spacing="4" alignment="CENTER_LEFT" visible="false" managed="false">
                            <Button fx:id="navMenuCaixa"      text="💼 Sessão Caixa" styleClass="nav-btn"/>
                            <Button fx:id="navMenuPagamentos" text="💳 Recebimentos" styleClass="nav-btn"/>
                            <Button fx:id="navMenuDespesas"   text="📉 Despesas" styleClass="nav-btn"/>
                            <Button fx:id="navMenuFinanceiro" text="📈 Resumo Caixa" styleClass="nav-btn"/>
                        </HBox>

                        <!-- 3. Stock & Artigos: Famílias | Artigos | Inventário | Fabrico -->
                        <HBox fx:id="navOperacoesItems" spacing="4" alignment="CENTER_LEFT" visible="false" managed="false">
                            <Button fx:id="navMenuCatalogos" text="📑 Famílias" styleClass="nav-btn"/>
                            <Button fx:id="navMenuProdutos"  text="🏷️ Artigos &amp; Preços" styleClass="nav-btn"/>
                            <Button fx:id="navMenuStock"     text="📊 Inventário" styleClass="nav-btn"/>
                            <Button fx:id="navMenuProducao"  text="🥖 Fabrico" styleClass="nav-btn"/>
                        </HBox>

                        <!-- 4. Armazém & Compras: Armazéns | Fornecedores | Compras | Stock Armazém | Transferências -->
                        <HBox fx:id="navArmazensItems" spacing="4" alignment="CENTER_LEFT" visible="false" managed="false">
                            <Button fx:id="navMenuArmazens"     text="🏢 Armazéns" styleClass="nav-btn"/>
                            <Button fx:id="navMenuFornecedores" text="🚛 Fornecedores" styleClass="nav-btn"/>
                            <Button fx:id="navMenuCompras"      text="📥 Compras" styleClass="nav-btn"/>
                            <Button fx:id="navMenuStockArmazem" text="📦 Stock Armazém" styleClass="nav-btn"/>
                            <Button fx:id="navMenuTransferir"   text="🔁 Transferências" styleClass="nav-btn"/>
                        </HBox>

                        <!-- 5. Mapas & Relatórios: um botão por mapa (sem abas) -->
                        <HBox fx:id="navRelatoriosItems" spacing="4" alignment="CENTER_LEFT" visible="false" managed="false">
                            <Button fx:id="navMenuRepVendas"         text="📊 Mapa de Vendas"      styleClass="nav-btn"/>
                            <Button fx:id="navMenuRepMaisVendidos"  text="🔥 Mais Vendidos"       styleClass="nav-btn"/>
                            <Button fx:id="navMenuRepIva"           text="🏛️ Apuramento IVA"     styleClass="nav-btn"/>
                            <Button fx:id="navMenuRepDevedores"     text="👥 Contas Correntes"    styleClass="nav-btn"/>
                            <Button fx:id="navMenuRepKardex"        text="📦 Kardex"              styleClass="nav-btn"/>
                            <Button fx:id="navMenuRepStockArmazem"  text="🏢 Stock por Armazém"   styleClass="nav-btn"/>
                            <Button fx:id="navMenuRepTransferencias" text="🔁 Transferências"     styleClass="nav-btn"/>
                            <Button fx:id="navMenuRepPagamentos"    text="📑 Pag. Fornecedores"   styleClass="nav-btn"/>
                        </HBox>

                        <!-- 6. Configurações & Sistema: Parâmetros | Utilizadores -->
                        <HBox fx:id="navAdminItems" spacing="4" alignment="CENTER_LEFT" visible="false" managed="false">
                            <Button fx:id="navMenuSistema" text="⚙️ Parâmetros" styleClass="nav-btn"/>
                            <Button fx:id="navMenuUsers"   text="👤 Utilizadores" styleClass="nav-btn"/>
                            <Button fx:id="navMenuBackups" text="💾 Backups" styleClass="nav-btn"/>
                            <Button fx:id="navMenuTreinamento" text="🎓 Treinamento" styleClass="nav-btn"/>
                            <Button fx:id="navMenuLicenca" text="🔑 Licenciamento" styleClass="nav-btn"/>
                            <Button fx:id="navMenuSeguranca" text="🔒 Segurança" styleClass="nav-btn"/>
                        </HBox>
                    </HBox>
                </StackPane>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Right Side Actions & User Profile Cards -->
                <HBox spacing="8" alignment="CENTER_RIGHT">

                    <!-- Cash Status Badge -->
                    <Label fx:id="cashStatusBadge" text="○ Caixa Fechado"
                           style="-fx-background-color: rgba(239, 68, 68, 0.18); -fx-border-color: rgba(239, 68, 68, 0.60); -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #FCA5A5; -fx-padding: 6 10; -fx-font-size: 11px; -fx-font-weight: 800; -fx-cursor: hand;"/>

                    <!-- Notifications Bell Card -->
                    <StackPane style="-fx-padding: 0 2;">
                        <Button fx:id="notificationBellButton" text="🔔 Alertas" styleClass="nav-bell-btn"/>
                        <Label fx:id="notificationBadge" text="0"
                               style="-fx-background-color: #EF4444; -fx-text-fill: #FFFFFF; -fx-font-size: 10px; -fx-font-weight: 900; -fx-background-radius: 10; -fx-border-color: #FFFFFF; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-padding: 1 5; -fx-min-width: 16; -fx-alignment: center;"
                               StackPane.alignment="TOP_RIGHT" translateX="6" translateY="-5" visible="false" managed="false"/>
                    </StackPane>

                    <Separator orientation="VERTICAL" style="-fx-padding: 8 2; -fx-opacity: 0.35;"/>

                    <!-- User Profile Card with Border -->
                    <HBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(0, 0, 0, 0.25); -fx-border-color: rgba(255, 255, 255, 0.20); -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 4 10;">
                        <Label fx:id="userAvatar" text="A"
                               style="-fx-background-color: #2563EB; -fx-text-fill: #FFFFFF; -fx-font-weight: 900; -fx-background-radius: 14; -fx-min-width: 26; -fx-min-height: 26; -fx-max-width: 26; -fx-max-height: 26; -fx-alignment: center; -fx-font-size: 12px; -fx-border-color: #93C5FD; -fx-border-radius: 14; -fx-border-width: 1;"/>
                        <VBox alignment="CENTER_LEFT" spacing="0">
                            <Label fx:id="userNameLabel" text="Administrador"
                                   style="-fx-font-weight: 800; -fx-text-fill: #FFFFFF; -fx-font-size: 11px;"/>
                            <Label fx:id="userRoleLabel" text="ADMIN"
                                   style="-fx-font-weight: 700; -fx-text-fill: #93C5FD; -fx-font-size: 9px;"/>
                        </VBox>
                    </HBox>

                    <!-- Logout Button -->
                    <Button fx:id="logoutButton" text="⏻ Sair" styleClass="logout-btn"/>
                </HBox>
            </HBox>

            <!-- Page Title Sub-bar with Crisp Borders & Shadows -->
            <HBox alignment="CENTER_LEFT" spacing="8"
                  style="-fx-padding: 8 20; -fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-width: 0 0 1 0; -fx-min-height: 40; -fx-max-height: 40;">
                <Label fx:id="pageTitleLabel" text="Dashboard"
                       style="-fx-font-size: 13px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
                <Label text="/" style="-fx-text-fill: #94A3B8; -fx-font-size: 13px; -fx-font-weight: 700;"/>
                <Label fx:id="pageSubtitleLabel" text="Visão geral do sistema"
                       style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="welcomeText" text="Bem-vindo ao SGV."
                       style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #64748B;"/>
            </HBox>
        </VBox>
    </top>

    <!-- ══════════════════════════════════════════════
         MAIN WORKSPACE
         ══════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    style="-fx-background:#F8FAFC; -fx-background-color:#F8FAFC; -fx-border-color:transparent;"
                    hbarPolicy="NEVER">
            <content>
                <VBox style="-fx-padding:24; -fx-background-color:#F8FAFC;" fillWidth="true">
                    <StackPane fx:id="contentPane" maxWidth="Infinity" VBox.vgrow="ALWAYS">

                        <!-- DASHBOARD / SUMARIO -->
                        <VBox fx:id="summaryPane" spacing="16" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                            <!-- Quick Actions -->
                            <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-padding: 0 0 8 0;">
                                <Button fx:id="shortcutCotacaoButton" text="Fazer Cotação"
                                        style="-fx-background-color:#F8FAFC; -fx-text-fill:#0F172A; -fx-font-weight:700; -fx-font-size:14px; -fx-padding:10 24; -fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-width:1; -fx-border-radius:8; -fx-cursor:hand;"/>
                                <Button fx:id="shortcutPDVButton" text="Fazer Venda (PDV)"
                                        style="-fx-background-color:#2563EB; -fx-text-fill:white; -fx-font-weight:700; -fx-font-size:14px; -fx-padding:10 24; -fx-background-radius:8; -fx-cursor:hand; -fx-effect:dropshadow(gaussian,rgba(37,99,235,0.25),6,0,0,2);"/>
                            </HBox>

                            <!-- KPI Row -->
                            <GridPane hgap="16" vgap="16">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                </columnConstraints>
                                <children>
                                    <VBox GridPane.columnIndex="0" styleClass="card-pane" style="-fx-padding:20;">
                                        <HBox spacing="14" alignment="CENTER_LEFT">
                                            <Label text="&#128178;" styleClass="kpi-icon kpi-icon-blue"/>
                                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                <Label text="Vendas de Hoje" style="-fx-font-size:12px; -fx-text-fill:#0F172A; -fx-font-weight:700;"/>
                                                <Label fx:id="salesLabel" text="—" style="-fx-font-size:26px; -fx-font-weight:800; -fx-text-fill:#0F172A;"/>
                                                <Label text="Facturado hoje no balcão" style="-fx-font-size:11px; -fx-text-fill:#64748B;"/>
                                            </VBox>
                                        </HBox>
                                    </VBox>
                                    <VBox GridPane.columnIndex="1" styleClass="card-pane" style="-fx-padding:20;">
                                        <HBox spacing="14" alignment="CENTER_LEFT">
                                            <Label text="&#128230;" styleClass="kpi-icon kpi-icon-purple"/>
                                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                <Label text="Artigos em Rutura" style="-fx-font-size:12px; -fx-text-fill:#0F172A; -fx-font-weight:700;"/>
                                                <Label fx:id="productsLabel" text="—" style="-fx-font-size:26px; -fx-font-weight:800; -fx-text-fill:#0F172A;"/>
                                                <Label text="Abaixo do stock mínimo" style="-fx-font-size:11px; -fx-text-fill:#64748B;"/>
                                            </VBox>
                                        </HBox>
                                    </VBox>
                                    <VBox GridPane.columnIndex="2" styleClass="card-pane" style="-fx-padding:20;">
                                        <HBox spacing="14" alignment="CENTER_LEFT">
                                            <Label text="&#128101;" styleClass="kpi-icon kpi-icon-green"/>
                                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                <Label text="Contas a Receber" style="-fx-font-size:12px; -fx-text-fill:#0F172A; -fx-font-weight:700;"/>
                                                <Label fx:id="customersLabel" text="—" style="-fx-font-size:26px; -fx-font-weight:800; -fx-text-fill:#0F172A;"/>
                                                <Label text="Crédito pendente de clientes" style="-fx-font-size:11px; -fx-text-fill:#64748B;"/>
                                            </VBox>
                                        </HBox>
                                    </VBox>
                                     <VBox GridPane.columnIndex="3" styleClass="card-pane" style="-fx-padding:20;">
                                         <HBox spacing="14" alignment="CENTER_LEFT">
                                             <Label text="&#128181;" styleClass="kpi-icon kpi-icon-orange"/>
                                             <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                 <Label text="Caixa / Gaveta" style="-fx-font-size:12px; -fx-text-fill:#0F172A; -fx-font-weight:700;"/>
                                                 <Label fx:id="branchesLabel" text="—" style="-fx-font-size:26px; -fx-font-weight:800; -fx-text-fill:#15803D;"/>
                                                 <Label text="Saldo líquido no turno actual" style="-fx-font-size:11px; -fx-text-fill:#64748B;"/>
                                             </VBox>
                                         </HBox>
                                     </VBox>
                                </children>
                            </GridPane>

                            <!-- Charts -->
                            <HBox styleClass="card-pane" style="-fx-padding:0;">
                                <VBox style="-fx-padding:20;" HBox.hgrow="ALWAYS">
                                    <Label text="Vendas Diárias — Últimos 7 dias"
                                           style="-fx-font-size:14px; -fx-font-weight:700; -fx-text-fill:#0F172A; -fx-padding:0 0 16 0;"/>
                                    <LineChart fx:id="salesLineChart" prefHeight="280" legendVisible="false">
                                        <xAxis><CategoryAxis side="BOTTOM"/></xAxis>
                                        <yAxis><NumberAxis side="LEFT"/></yAxis>
                                    </LineChart>
                                </VBox>
                                <Separator orientation="VERTICAL" style="-fx-background-color:#E2E8F0; -fx-padding:12 0;"/>
                                <VBox style="-fx-padding:20;" minWidth="320">
                                    <Label text="Meios de Pagamento — Hoje"
                                           style="-fx-font-size:14px; -fx-font-weight:700; -fx-text-fill:#0F172A; -fx-padding:0 0 16 0;"/>
                                    <PieChart fx:id="salesPieChart" prefHeight="280" legendSide="BOTTOM"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- ESTATISTICAS DE VENDAS -->
                        <VBox fx:id="salesStatsPane" spacing="16" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- VENDAS -->
                        <VBox fx:id="salesPane" spacing="16" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- PRODUTOS -->
                        <VBox fx:id="productsPane" spacing="16" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- CLIENTES -->
                        <VBox fx:id="customersPane" spacing="16" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- STOCK -->
                        <VBox fx:id="stockPane" spacing="16" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- ARMAZENS (WAREHOUSE DASHBOARD) -->
                        <VBox fx:id="warehousesPane" spacing="16" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- STOCK POR ARMAZÉM -->
                        <VBox fx:id="stockArmazemPane" spacing="16" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- TRANSFERÊNCIAS / GUIAS DE TRANSPORTE -->
                        <VBox fx:id="transfersPane" spacing="16" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- TURNO / CAIXA -->
                        <VBox fx:id="turnoCaixaPane" spacing="20" visible="false" managed="false" maxWidth="Infinity"/>

                        <!-- COMPRAS / FORNECEDORES -->
                        <VBox fx:id="comprasPane" spacing="16" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- FORNECEDORES -->
                        <VBox fx:id="fornecedoresPane" spacing="16" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- FINANCEIRO: Pagamentos | Despesas -->
                        <VBox fx:id="financeiroPane" spacing="16" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                            <HBox spacing="12" alignment="CENTER_LEFT"
                                  style="-fx-background-color:#ffffff; -fx-padding:18 20; -fx-border-color:#E2E8F0; -fx-border-width:1; -fx-border-radius:12; -fx-background-radius:12;">
                                <VBox spacing="4">
                                    <Label text="Financeiro" style="-fx-font-size:18px; -fx-font-weight:700; -fx-text-fill:#0F172A;"/>
                                    <Label text="Visão geral financeira" style="-fx-font-size:12px; -fx-text-fill:#64748B;"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                            </HBox>
                            <GridPane id="financeiroKPI" hgap="16" vgap="16"
                                      style="-fx-background-color:#ffffff; -fx-padding:18 20 16 20; -fx-border-color:#E2E8F0; -fx-border-width:1; -fx-border-radius:12; -fx-background-radius:12;">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                </columnConstraints>
                                <children>
                                    <VBox GridPane.columnIndex="0" spacing="4">
                                        <Label text="Total Vendas" style="-fx-font-size:11px; -fx-text-fill:#475569;"/>
                                        <Label fx:id="finTotalVendasLabel" text="0.00 MT" style="-fx-font-size:18px; -fx-font-weight:700;"/>
                                    </VBox>
                                    <VBox GridPane.columnIndex="1" spacing="4">
                                        <Label text="Recebido" style="-fx-font-size:11px; -fx-text-fill:#475569;"/>
                                        <Label fx:id="finTotalRecebidoLabel" text="0.00 MT" style="-fx-font-size:18px; -fx-font-weight:700;"/>
                                    </VBox>
                                    <VBox GridPane.columnIndex="2" spacing="4">
                                        <Label text="Pendente" style="-fx-font-size:11px; -fx-text-fill:#475569;"/>
                                        <Label fx:id="finPendenteLabel" text="0.00 MT" style="-fx-font-size:18px; -fx-font-weight:700;"/>
                                    </VBox>
                                    <VBox GridPane.columnIndex="3" spacing="4">
                                        <Label text="Pagamentos" style="-fx-font-size:11px; -fx-text-fill:#475569;"/>
                                        <Label fx:id="finNumPagamentosLabel" text="0" style="-fx-font-size:18px; -fx-font-weight:700;"/>
                                    </VBox>
                                </children>
                            </GridPane>
                        </VBox>

                        <!-- PAGAMENTOS -->
                        <VBox fx:id="pagamentosPane" spacing="16" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                                <HBox spacing="12" alignment="CENTER_LEFT"
                                      style="-fx-background-color:#ffffff; -fx-padding:18 20; -fx-border-color:#E2E8F0; -fx-border-width:1; -fx-border-radius:12; -fx-background-radius:12;">
                                    <VBox spacing="4">
                                        <Label text="Pagamentos" style="-fx-font-size:18px; -fx-font-weight:700; -fx-text-fill:#0F172A;"/>
                                        <Label text="Registo de pagamentos recebidos" style="-fx-font-size:12px; -fx-text-fill:#64748B;"/>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="createPaymentButton" text="+ Pagamento" styleClass="primary-button"/>
                                </HBox>
                                <VBox spacing="10"
                                      style="-fx-background-color:#ffffff; -fx-padding:20; -fx-border-color:#E2E8F0; -fx-border-width:1; -fx-border-radius:12; -fx-background-radius:12;">
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Button fx:id="deletePaymentButton" text="Apagar" styleClass="danger-button"/>
                                    </HBox>
                                    <TableView fx:id="paymentsTable" prefHeight="520" styleClass="cash-table compact-table">
                                        <columns>
                                            <TableColumn text="Data" prefWidth="150">
                                                <cellValueFactory>
                                                    <PropertyValueFactory property="createdAt"/>
                                                </cellValueFactory>
                                            </TableColumn>
                                            <TableColumn text="Cliente" prefWidth="220">
                                                <cellValueFactory>
                                                    <PropertyValueFactory property="saleCustomerName"/>
                                                </cellValueFactory>
                                            </TableColumn>
                                            <TableColumn text="Valor" prefWidth="140">
                                                <cellValueFactory>
                                                    <PropertyValueFactory property="amount"/>
                                                </cellValueFactory>
                                            </TableColumn>
                                            <TableColumn text="Método" prefWidth="180">
                                                <cellValueFactory>
                                                    <PropertyValueFactory property="method"/>
                                                </cellValueFactory>
                                            </TableColumn>
                                        </columns>
                                    </TableView>
                            </VBox>
                        </VBox>

                        <!-- DESPESAS -->
                        <VBox fx:id="despesasPane" spacing="16" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                                <HBox spacing="12" alignment="CENTER_LEFT"
                                      style="-fx-background-color:#ffffff; -fx-padding:18 20; -fx-border-color:#E2E8F0; -fx-border-width:1; -fx-border-radius:12; -fx-background-radius:12;">
                                    <VBox spacing="4">
                                        <Label text="Despesas" style="-fx-font-size:18px; -fx-font-weight:700; -fx-text-fill:#0F172A;"/>
                                        <Label text="Registo de despesas" style="-fx-font-size:12px; -fx-text-fill:#64748B;"/>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="createExpenseButton" text="+ Despesa" styleClass="secondary-button"/>
                                </HBox>
                                <VBox spacing="10"
                                      style="-fx-background-color:#ffffff; -fx-padding:20; -fx-border-color:#E2E8F0; -fx-border-width:1; -fx-border-radius:12; -fx-background-radius:12;">
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Button fx:id="editExpenseButton" text="Editar" styleClass="secondary-button"/>
                                        <Button fx:id="deleteExpenseButton" text="Apagar" styleClass="danger-button"/>
                                    </HBox>
                                    <TableView fx:id="expensesTable" prefHeight="520" styleClass="cash-table compact-table">
                                        <columns>
                                            <TableColumn text="Data" prefWidth="140">
                                                <cellValueFactory>
                                                    <PropertyValueFactory property="createdAt"/>
                                                </cellValueFactory>
                                            </TableColumn>
                                            <TableColumn text="Descrição" prefWidth="260">
                                                <cellValueFactory>
                                                    <PropertyValueFactory property="description"/>
                                                </cellValueFactory>
                                            </TableColumn>
                                            <TableColumn text="Categoria" prefWidth="160">
                                                <cellValueFactory>
                                                    <PropertyValueFactory property="category"/>
                                                </cellValueFactory>
                                            </TableColumn>
                                            <TableColumn text="Valor" prefWidth="120">
                                                <cellValueFactory>
                                                    <PropertyValueFactory property="amount"/>
                                                </cellValueFactory>
                                            </TableColumn>
                                            <TableColumn text="Estado" prefWidth="120">
                                                <cellValueFactory>
                                                    <PropertyValueFactory property="state"/>
                                                </cellValueFactory>
                                            </TableColumn>
                                        </columns>
                                    </TableView>
                                </VBox>
                            </VBox>

                        <!-- CATÁLOGOS: Categorias | Unidades -->
                        <VBox fx:id="catalogsPane" spacing="0" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- RELATÓRIOS -->
                        <VBox fx:id="reportsPane" spacing="0" visible="false" managed="false"
                              maxWidth="Infinity" maxHeight="Infinity" minHeight="600" VBox.vgrow="ALWAYS"
                              style="-fx-background-color:#F8FAFC;"/>

                        <!-- UTILIZADORES -->
                        <VBox fx:id="usersPane" spacing="16" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- SISTEMA -->
                        <VBox fx:id="sistemaPane" spacing="0" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- BACKUPS -->
                        <VBox fx:id="backupsPane" spacing="0" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- TREINAMENTO -->
                        <VBox fx:id="treinamentoPane" spacing="0" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- LICENCIAMENTO -->
                        <VBox fx:id="licencaPane" spacing="0" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- SEGURANÇA -->
                        <VBox fx:id="segurancaPane" spacing="0" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- PRODUÇÃO -->
                        <VBox fx:id="producaoPane" spacing="16" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                        <!-- LOGS DO SISTEMA -->
                        <VBox fx:id="logsPane" spacing="0" visible="false" managed="false" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

                    </StackPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
