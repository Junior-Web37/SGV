<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgv.desktop.ProductFormController"
      spacing="0" styleClass="card-pane" style="-fx-padding:0; -fx-background-radius:8; -fx-background-color:#ffffff;"
      prefWidth="900" prefHeight="720" stylesheets="@/styles/styles.css">

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color:#0F172A; -fx-padding:20 24; -fx-border-color:#E2E8F0; -fx-border-width:0 0 1 0; -fx-background-radius:3 3 0 0;">
            <VBox spacing="4">
                <Label text="Registo de Produto" style="-fx-font-size:18px; -fx-font-weight:600; -fx-text-fill:#ffffff;"/>
                <Label text="Preencha as informações do produto" style="-fx-font-size:12px; -fx-text-fill:#94A3B8;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <CheckBox fx:id="activeCheck" text="Produto Activo" selected="true"
                      style="-fx-font-size:13px; -fx-text-fill:#ffffff; -fx-font-weight:600;"/>
        </HBox>

        <!-- CONTENT -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background:#ffffff; -fx-background-color:#ffffff;"
                    styleClass="edge-to-edge" hbarPolicy="NEVER">
            <VBox spacing="20" style="-fx-padding:24;">
                
                <!-- ERRO -->
                <Label fx:id="errorLabel" text="" wrapText="true"
                       style="-fx-text-fill:#EF4444; -fx-font-size:13px; -fx-font-weight:600; -fx-background-color:#FEE2E2; -fx-background-radius:3; -fx-padding:8 12;"
                       visible="false" managed="false"/>

                <!-- 1. DADOS GERAIS -->
                <VBox spacing="12">
                    <Label text="DADOS GERAIS" style="-fx-font-size:11px; -fx-font-weight:700; -fx-text-fill:#475569;"/>
                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33"/>
                            <ColumnConstraints percentWidth="34"/>
                            <ColumnConstraints percentWidth="33"/>
                        </columnConstraints>
                        <children>
                            <!-- Código -->
                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Código / SKU *" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="codeField"
                                           style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                                <Label text="3 iniciais + número" style="-fx-font-size:10px; -fx-text-fill:#94A3B8;"/>
                            </VBox>
                            <!-- Nome -->
                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.columnSpan="2">
                                <Label text="Nome do Produto *" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="nameField"
                                           style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                            </VBox>
                            <!-- Categoria -->
                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Categoria *" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <ComboBox fx:id="categoryCombo"
                                           style="-fx-pref-width:1000; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#F8FAFC;"/>
                            </VBox>
                            <!-- Fornecedor -->
                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Fornecedor (Opcional)" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <ComboBox fx:id="supplierCombo"
                                           style="-fx-pref-width:1000; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#F8FAFC;"/>
                            </VBox>
                            <!-- Serviço -->
                            <VBox alignment="CENTER_LEFT" spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                <Label text="" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <CheckBox fx:id="isServiceCheckbox" text="É um serviço"
                                          style="-fx-text-fill:#0F172A; -fx-font-size:13px;"/>
                            </VBox>
                        </children>
                    </GridPane>
                </VBox>

                <Separator style="-fx-opacity:0.2;"/>

                <!-- 2. PREÇOS E MARGEM (autocalculada) -->
                <VBox spacing="12">
                    <Label text="PREÇOS E MARGEM" style="-fx-font-size:11px; -fx-font-weight:700; -fx-text-fill:#475569;"/>
                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33"/>
                            <ColumnConstraints percentWidth="34"/>
                            <ColumnConstraints percentWidth="33"/>
                        </columnConstraints>
                        <children>
                            <!-- Preço Custo -->
                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Preço de Custo (MT)" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="priceCostField"
                                           style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                            </VBox>
                            <!-- Preço Venda -->
                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Preço de Venda * (MT)" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="priceSaleField"
                                           style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                            </VBox>
                            <!-- Margem Lucro (autocalculada) -->
                            <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="Margem Lucro (%)" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="profitMarginField" editable="false"
                                           style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#CBD5E1; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#E2E8F0; -fx-text-fill:#64748B;"/>
                                <Label text="Calculado automaticamente" style="-fx-font-size:10px; -fx-text-fill:#94A3B8;"/>
                            </VBox>
                            <!-- IVA (automático do sistema) -->
                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="IVA / Taxa (%)" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="taxRateField"
                                           style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                                <Label fx:id="taxRateHint" text="Padrão: 16%" style="-fx-font-size:10px; -fx-text-fill:#94A3B8;"/>
                            </VBox>

                        </children>
                    </GridPane>
                </VBox>

                <Separator style="-fx-opacity:0.2;"/>

                <!-- 3. VENDA POR ATACADO -->
                <VBox spacing="12">
                    <Label text="VENDA POR ATACADO" style="-fx-font-size:11px; -fx-font-weight:700; -fx-text-fill:#475569;"/>
                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                        </columnConstraints>
                        <children>
                            <!-- Unidade Base -->
                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Unidade Base" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <ComboBox fx:id="unitField"
                                           style="-fx-pref-width:1000; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#F8FAFC;"/>
                            </VBox>
                            <!-- Preço Atacado -->
                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Preço Atacado (MT)" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="priceSaleBulkField"
                                           style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                            </VBox>
                            <!-- Qtd Mín Atacado -->
                            <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="Qtd Mín Atacado" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="bulkQuantityField" text="1"
                                           style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                            </VBox>
                            <!-- Unid. Atacado -->
                            <VBox spacing="6" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                <Label text="Unid. Atacado" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <ComboBox fx:id="unitBulkField"
                                           style="-fx-pref-width:1000; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#F8FAFC;"/>
                            </VBox>
                            <!-- Factor Conversão -->
                            <VBox spacing="6" GridPane.columnIndex="4" GridPane.rowIndex="0">
                                <Label text="Factor Conversão" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="conversionFactorField" text="1.0"
                                           style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                            </VBox>
                        </children>
                    </GridPane>
                </VBox>

                <Separator style="-fx-opacity:0.2;"/>

                <!-- 4. STOCK MÁXIMO E MÍNIMO -->
                <VBox spacing="12">
                    <Label text="CONTROLO DE STOCK" style="-fx-font-size:11px; -fx-font-weight:700; -fx-text-fill:#475569;"/>
                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <children>
                            <!-- Stock Mínimo -->
                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Stock Mínimo (Alerta Reposição)" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="stockMinField" text="0"
                                           style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                                <Label text="Alerta quando stock atingir este nível" style="-fx-font-size:10px; -fx-text-fill:#94A3B8;"/>
                            </VBox>
                            <!-- Stock Máximo -->
                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Stock Máximo (Capacidade)" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                                <TextField fx:id="stockMaxField" text="0"
                                           style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                                <Label text="Alerta quando stock exceder este nível" style="-fx-font-size:10px; -fx-text-fill:#94A3B8;"/>
                            </VBox>
                        </children>
                    </GridPane>
                </VBox>

                <Separator style="-fx-opacity:0.2;"/>

                <!-- 5. CÓDIGOS DE BARRAS -->
                <VBox spacing="12">
                    <Label text="CÓDIGOS DE BARRAS" style="-fx-font-size:11px; -fx-font-weight:700; -fx-text-fill:#475569;"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <TextField fx:id="barcodeField" promptText="Código de barras..."
                                   style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A; -fx-pref-width:250;"/>
                        <TextField fx:id="barcodeQtyField" text="1.0"
                                   style="-fx-pref-width:70; -fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                        <Label text="Qtd" style="-fx-font-size:12px; -fx-text-fill:#475569; -fx-font-weight:600;"/>
                        <Button fx:id="addBarcodeButton" text="Adicionar"
                                style="-fx-padding:8 16; -fx-font-size:13px; -fx-background-color:#2563EB; -fx-text-fill:white; -fx-font-weight:600; -fx-background-radius:3; -fx-cursor:hand;"/>
                        <Button fx:id="removeBarcodeButton" text="Remover"
                                style="-fx-padding:8 16; -fx-font-size:13px; -fx-background-color:#DC2626; -fx-text-fill:white; -fx-font-weight:600; -fx-background-radius:3; -fx-cursor:hand;"/>
                    </HBox>
                    <TableView fx:id="barcodeTable" prefHeight="120" style="-fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3;">
                        <columns>
                            <TableColumn fx:id="barcodeCodeColumn" text="Código de Barras" prefWidth="300"/>
                            <TableColumn fx:id="barcodeQtyColumn" text="Quantidade" prefWidth="100"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <Separator style="-fx-opacity:0.2;"/>

                <!-- 6. DESCRIÇÃO -->
                <VBox spacing="12">
                    <Label text="DESCRIÇÃO" style="-fx-font-size:11px; -fx-font-weight:700; -fx-text-fill:#475569;"/>
                    <TextArea fx:id="descriptionArea" wrapText="true"
                              style="-fx-padding:8 12; -fx-background-radius:3; -fx-border-color:#E2E8F0; -fx-border-radius:3; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A; -fx-min-height:60; -fx-max-height:100;"
                              promptText="Descrição curta do produto..."/>
                </VBox>

                <!-- BOTÕES -->
                <Separator style="-fx-opacity:0.2;"/>
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button fx:id="deleteButton" text="Apagar Produto"
                            style="-fx-padding:8 16; -fx-font-size:13px; -fx-background-color:#DC2626; -fx-text-fill:white; -fx-background-radius:3; -fx-cursor:hand; -fx-font-weight:600;"/>
                    <Button fx:id="cancelButton" text="Cancelar" styleClass="btn-secondary-ux"
                            style="-fx-padding:8 16; -fx-font-size:13px; -fx-background-color:#ffffff; -fx-text-fill:#0F172A; -fx-background-radius:3; -fx-cursor:hand; -fx-font-weight:600; -fx-border-color:#E2E8F0; -fx-border-radius:3;"/>
                    <StackPane>
                        <Button fx:id="saveButton" text="Salvar Produto" styleClass="btn-primary-ux"
                                style="-fx-padding:8 16; -fx-font-size:13px; -fx-background-color:#2563EB; -fx-text-fill:white; -fx-font-weight:600; -fx-background-radius:3; -fx-cursor:hand;"/>
                        <ProgressIndicator fx:id="saveSpinner" visible="false" managed="false"
                                           style="-fx-progress-color:white; -fx-max-width:20; -fx-max-height:20;"/>
                    </StackPane>
                </HBox>
            </VBox>
        </ScrollPane>
    </VBox>
