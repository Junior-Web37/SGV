<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgv.desktop.WarehouseTransferFormController"
      spacing="0" styleClass="card-pane" style="-fx-padding:0; -fx-background-radius:10; -fx-background-color:#ffffff;"
      prefWidth="940" prefHeight="650" stylesheets="@/styles/styles.css">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="14"
          style="-fx-background-color: linear-gradient(to right, #1E3A8A, #1D4ED8, #1E40AF); -fx-padding:18 24; -fx-border-color:#1E293B; -fx-border-width:0 0 2 0; -fx-background-radius:10 10 0 0;">
        <VBox spacing="3">
            <Label text="🔁 Emissão de Guia de Transferência de Stock (TWA)" style="-fx-font-size:18px; -fx-font-weight:800; -fx-text-fill:#ffffff;"/>
            <Label text="Expedição física de mercadorias do Armazém Central para abastecimento de loja" style="-fx-font-size:12px; -fx-text-fill:#94A3B8;"/>
        </VBox>
    </HBox>

    <VBox spacing="16" style="-fx-padding:24; -fx-background-color:#ffffff; -fx-background-radius:0 0 10 10;" VBox.vgrow="ALWAYS">
        <!-- ORIGEM E DESTINO -->
        <HBox spacing="14" alignment="CENTER_LEFT"
              style="-fx-background-color:#F8FAFC; -fx-padding:14 18; -fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-width:1; -fx-border-radius:8;">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Armazém Central de Origem *" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#2563EB;"/>
                <ComboBox fx:id="warehouseCombo" promptText="Seleccione o armazém..."
                          style="-fx-pref-width:1000; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#FFFFFF;"/>
            </VBox>
            <Label text="➔" style="-fx-font-size:20px; -fx-text-fill:#64748B; -fx-padding:14 4 0 4;"/>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Filial / Estabelecimento de Destino *" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#10B981;"/>
                <ComboBox fx:id="branchCombo" promptText="Seleccione a filial..."
                          style="-fx-pref-width:1000; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-padding:4; -fx-background-color:#FFFFFF;"/>
            </VBox>
        </HBox>

        <!-- SELETOR DE ARTIGO -->
        <VBox spacing="6"
              style="-fx-background-color:#FFFFFF; -fx-padding:12 16; -fx-background-radius:8; -fx-border-color:#CBD5E1; -fx-border-width:1; -fx-border-radius:8;">
            <Label text="ADICIONAR ARTIGO À GUIA DE TRANSPORTE" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#475569;"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Produto / Artigo" style="-fx-font-size:10px; -fx-text-fill:#64748B; -fx-font-weight:700;"/>
                    <TextField fx:id="productSearchField" promptText="Digite o código, o nome ou leia o código de barras..."
                               style="-fx-pref-width:1000; -fx-background-radius:6; -fx-border-color:#CBD5E1; -fx-border-radius:6; -fx-font-size:13px; -fx-padding:8 10; -fx-background-color:#FFFFFF;"/>
                    <ListView fx:id="productList" prefHeight="148"
                              style="-fx-background-radius:6; -fx-border-color:#E2E8F0; -fx-border-radius:6; -fx-font-size:13px;"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="Quantidade" style="-fx-font-size:10px; -fx-text-fill:#64748B; -fx-font-weight:700;"/>
                    <TextField fx:id="quantityField" text="1" promptText="1"
                               style="-fx-pref-width:85; -fx-padding:8 10; -fx-background-radius:6; -fx-border-color:#10B981; -fx-border-radius:6; -fx-font-size:14px; -fx-font-weight:800; -fx-background-color:#FFFFFF; -fx-alignment:center;"/>
                </VBox>
                <VBox spacing="2" alignment="BOTTOM_CENTER">
                    <Label text=" " style="-fx-font-size:10px;"/>
                    <Button fx:id="addItemButton" text="+ Inserir no Lote" styleClass="btn-primary-ux"
                            style="-fx-font-size:12px; -fx-padding:8 16;"/>
                </VBox>
            </HBox>
            <Label fx:id="stockSummaryLabel" text="" style="-fx-font-size:11px; -fx-font-weight:700; -fx-text-fill:#2563EB; -fx-padding:2 0 0 0;"/>
        </VBox>

        <!-- TABELA DE ITENS DA GUIA -->
        <VBox spacing="6" VBox.vgrow="ALWAYS">
            <Label text="ARTIGOS INCLUÍDOS NA GUIA DE TRANSPORTE" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#475569;"/>
            <TableView fx:id="itemsTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="codeColumn" text="Código" prefWidth="130"/>
                    <TableColumn fx:id="productColumn" text="Artigo / Descrição" prefWidth="350"/>
                    <TableColumn fx:id="stockColumn" text="Stock no Armazém" prefWidth="150"/>
                    <TableColumn fx:id="quantityColumn" text="Qtd. a Transferir" prefWidth="150"/>
                    <TableColumn fx:id="actionColumn" text="" prefWidth="60"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <Label fx:id="errorLabel" visible="false" managed="false"
               style="-fx-text-fill:#EF4444; -fx-font-size:12px; -fx-font-weight:700; -fx-background-color:#FEE2E2; -fx-background-radius:6; -fx-padding:8 12; -fx-border-color:#FCA5A5; -fx-border-width:1; -fx-border-radius:6;"/>

        <Separator style="-fx-opacity:0.2;"/>
        <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding:4 0 0 0;">
            <Button fx:id="cancelButton" text="Cancelar" styleClass="btn-secondary-ux"/>
            <StackPane>
                <Button fx:id="saveButton" text="✓ Emitir Guia de Transferência" styleClass="btn-primary-ux"/>
                <ProgressIndicator fx:id="saveSpinner" visible="false" managed="false"
                                   style="-fx-progress-color:white; -fx-max-width:20; -fx-max-height:20;"/>
            </StackPane>
        </HBox>
    </VBox>
</VBox>
