<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sgv.desktop.CashSessionController" styleClass="cash-page">

    <top>
<HBox spacing="12" styleClass="cash-header-compact">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <VBox spacing="4">
                <Label text="Operador" styleClass="muted-label"/>
                <Label fx:id="operatorLabel" text="-" styleClass="metric-small"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Filial" styleClass="muted-label"/>
                <Label fx:id="branchLabel" text="-" styleClass="metric-small"/>
            </VBox>


            <VBox spacing="4">
                <Label text="Aberto" styleClass="muted-label"/>
                <Label fx:id="openedAtLabel" text="-" styleClass="metric-small"/>
            </VBox>

            <VBox spacing="4">
                <Label fx:id="statusBadge" text="🔴  FECHADO" style="-fx-background-color: #FEE2E2; -fx-text-fill: #EF4444; -fx-padding: 6 14; -fx-background-radius: 20; -fx-font-weight: 700; -fx-font-size: 13px;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox spacing="4" alignment="CENTER_RIGHT">
                <Label text="Total" styleClass="muted-label"/>
                <Label fx:id="systemValueLabel" text="0.00 MT" styleClass="metric-large"/>
            </VBox>

            <HBox spacing="6" alignment="CENTER_RIGHT">
                <Button fx:id="openSessionButton" text="Abrir" styleClass="primary-button"/>
                <Button fx:id="closeSessionButton" text="Fechar" styleClass="danger-button"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Resumo">
                    <VBox spacing="8">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <VBox>
                                <Label text="Resumo do Turno" styleClass="section-title"/>
                                <Label fx:id="statusSummaryLabel" text="Nenhum turno em andamento" styleClass="muted-label"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <HBox spacing="6">
                                <Button fx:id="addMovementButton" text="+ Movimento" styleClass="primary-button"/>
                                <Button fx:id="refreshMovementsButton" text="Atualizar" styleClass="secondary-button"/>
                            </HBox>
                        </HBox>

                        <TableView fx:id="movementsTable" VBox.vgrow="ALWAYS" styleClass="cash-table compact-table">
                            <columns>
                                <TableColumn fx:id="timeColumn" text="Hora" prefWidth="110"/>
                                <TableColumn fx:id="typeColumn" text="Tipo" prefWidth="110"/>
                                <TableColumn fx:id="operationKindColumn" text="Operação" prefWidth="120"/>
                                <TableColumn fx:id="reasonColumn" text="Motivo" prefWidth="200"/>
                                <TableColumn fx:id="amountColumn" text="Valor" prefWidth="110"/>
                                <TableColumn fx:id="descriptionColumn" text="Descrição" prefWidth="320"/>
                                <TableColumn fx:id="userColumn" text="Operador" prefWidth="140"/>
                            </columns>
                            <placeholder>
                                <Label fx:id="movementsHintLabel" text="Nenhum movimento registado." styleClass="muted-italic"/>
                            </placeholder>
                        </TableView>

                        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="summary-row" visible="true" managed="true">
                            <VBox spacing="2">
                                <Label text="Valor Inicial" styleClass="muted-label"/>
                                <Label fx:id="initialValueLabel" text="0.00 MT" styleClass="form-field-strong"/>
                            </VBox>
                            <VBox spacing="2">
                                <Label text="Entradas" styleClass="muted-label"/>
                                <Label fx:id="totalEntriesLabel" text="0.00 MT" styleClass="form-field-strong"/>
                            </VBox>
                            <VBox spacing="2">
                                <Label text="Saídas" styleClass="muted-label"/>
                                <Label fx:id="totalExitsLabel" text="0.00 MT" styleClass="form-field-strong"/>
                            </VBox>
                            <VBox spacing="2">
                                <Label text="Movimentos" styleClass="muted-label"/>
                                <Label fx:id="movementCountLabel" text="0" styleClass="form-field-strong"/>
                            </VBox>
                            <VBox spacing="2">
                                <Label text="Último" styleClass="muted-label"/>
                                <Label fx:id="lastMovementLabel" text="-" styleClass="form-field-strong"/>
                            </VBox>
                        </HBox>
                        <VBox fx:id="closedStatePane" visible="false" managed="false"/>
                        <VBox fx:id="openStatePane" visible="false" managed="false"/>
                    </VBox>
                </Tab>

                <Tab text="Histórico">
                    <VBox spacing="8">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Histórico de Turnos" styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="refreshHistoryButton" text="Atualizar" styleClass="secondary-button"/>
                            <Button fx:id="viewSessionButton" text="Ver" styleClass="primary-button"/>
                        </HBox>

                        <SplitPane orientation="VERTICAL" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets top="10" right="10" bottom="10" left="10"/>
                            </padding>
                            <items>
                                <TableView fx:id="historyTable" styleClass="cash-table compact-table">
                                    <columns>
                                        <TableColumn fx:id="historyOpenedColumn" text="Aberto" prefWidth="140"/>
                                        <TableColumn fx:id="historyClosedColumn" text="Fechado" prefWidth="140"/>
                                        <TableColumn fx:id="historyStateColumn" text="Estado" prefWidth="90"/>
                                        <TableColumn fx:id="historyInitialValueColumn" text="Valor Inicial" prefWidth="120"/>
                                        <TableColumn fx:id="historySystemValueColumn" text="Valor Sistema" prefWidth="120"/>
                                        <TableColumn fx:id="historyReportedValueColumn" text="Valor Reportado" prefWidth="120"/>
                                        <TableColumn fx:id="historyOperatorColumn" text="Operador" prefWidth="160"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="Nenhum histórico disponível" styleClass="muted-italic"/>
                                    </placeholder>
                                </TableView>
                            </items>
                        </SplitPane>
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </center>

</BorderPane>
