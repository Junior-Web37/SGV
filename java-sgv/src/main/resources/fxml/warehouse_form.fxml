<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgv.desktop.WarehouseFormController"
      spacing="12" style="-fx-padding:18; -fx-background-color:#F8FAFC;" prefWidth="600" prefHeight="500">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Armazém" style="-fx-font-size:16px; -fx-font-weight:800; -fx-text-fill:#0F172A;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <CheckBox fx:id="activeCheck" text="Activo" selected="true"
                  style="-fx-text-fill:#0F172A; -fx-font-size:12px; -fx-font-weight:700;"/>
    </HBox>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="75"/>
        </columnConstraints>
        <children>
            <Label text="Código *" GridPane.columnIndex="0" GridPane.rowIndex="0"
                   style="-fx-font-size:12px; -fx-font-weight:700;"/>
            <TextField fx:id="codeField" promptText="ARM-01" GridPane.columnIndex="1" GridPane.rowIndex="0"
                       style="-fx-font-size:12px; -fx-padding:6; -fx-background-radius:4; -fx-border-color:#E2E8F0; -fx-border-radius:4;"/>

            <Label text="Nome *" GridPane.columnIndex="0" GridPane.rowIndex="1"
                   style="-fx-font-size:12px; -fx-font-weight:700;"/>
            <TextField fx:id="nameField" promptText="Armazém Central" GridPane.columnIndex="1" GridPane.rowIndex="1"
                       style="-fx-font-size:12px; -fx-padding:6; -fx-background-radius:4; -fx-border-color:#E2E8F0; -fx-border-radius:4;"/>

            <Label text="NUIT" GridPane.columnIndex="0" GridPane.rowIndex="2"
                   style="-fx-font-size:12px; -fx-font-weight:700;"/>
            <TextField fx:id="nuitField" promptText="9 dígitos" GridPane.columnIndex="1" GridPane.rowIndex="2"
                       style="-fx-font-size:12px; -fx-padding:6; -fx-background-radius:4; -fx-border-color:#E2E8F0; -fx-border-radius:4;"/>

            <Label text="Endereço" GridPane.columnIndex="0" GridPane.rowIndex="3"
                   style="-fx-font-size:12px; -fx-font-weight:700;"/>
            <TextField fx:id="addressField" promptText="Av. de Moçambique, Matola" GridPane.columnIndex="1" GridPane.rowIndex="3"
                       style="-fx-font-size:12px; -fx-padding:6; -fx-background-radius:4; -fx-border-color:#E2E8F0; -fx-border-radius:4;"/>

            <Label text="Contacto" GridPane.columnIndex="0" GridPane.rowIndex="4"
                   style="-fx-font-size:12px; -fx-font-weight:700;"/>
            <TextField fx:id="contactField" promptText="+258 84 000 0000" GridPane.columnIndex="1" GridPane.rowIndex="4"
                       style="-fx-font-size:12px; -fx-padding:6; -fx-background-radius:4; -fx-border-color:#E2E8F0; -fx-border-radius:4;"/>

            <Label text="Notas" GridPane.columnIndex="0" GridPane.rowIndex="5"
                   style="-fx-font-size:12px; -fx-font-weight:700;"/>
            <TextArea fx:id="notesArea" GridPane.columnIndex="1" GridPane.rowIndex="5"
                      prefRowCount="2"
                      style="-fx-font-size:12px; -fx-padding:6; -fx-background-radius:4; -fx-border-color:#E2E8F0; -fx-border-radius:4;"/>
        </children>
    </GridPane>

    <Label fx:id="errorLabel" visible="false" managed="false"
           style="-fx-text-fill:#EF4444; -fx-font-size:11px; -fx-font-weight:700; -fx-background-color:#FEE2E2; -fx-background-radius:4; -fx-padding:6 10;"/>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" text="Cancelar"
                style="-fx-padding:9 20; -fx-background-color:#F8FAFC; -fx-text-fill:#475569; -fx-border-color:#E2E8F0; -fx-border-radius:6; -fx-background-radius:6; -fx-font-weight:700; -fx-cursor:hand;"/>
        <Button fx:id="saveButton" text="Guardar"
                style="-fx-padding:9 22; -fx-background-color:#2563EB; -fx-text-fill:#ffffff; -fx-font-weight:800; -fx-background-radius:6; -fx-cursor:hand;"/>
    </HBox>
</VBox>
