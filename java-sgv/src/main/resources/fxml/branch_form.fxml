<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sgv.desktop.BranchFormController"
      spacing="0" styleClass="card-pane" style="-fx-padding:0; -fx-background-radius:10; -fx-background-color:#ffffff;"
      prefWidth="640" prefHeight="480" stylesheets="@/styles/styles.css">

    <HBox alignment="CENTER_LEFT" spacing="14"
          style="-fx-background-color:#0F172A; -fx-padding:20 24; -fx-border-color:#E2E8F0; -fx-border-width:0 0 1 0; -fx-background-radius:10 10 0 0;">
        <VBox spacing="4">
            <Label text="Registo de Filial / Estabelecimento" style="-fx-font-size:18px; -fx-font-weight:700; -fx-text-fill:#ffffff;"/>
            <Label text="Cadastro de lojas, postos de venda, armazéns e sede central" style="-fx-font-size:12px; -fx-text-fill:#94A3B8;"/>
        </VBox>
    </HBox>

    <VBox spacing="18" style="-fx-padding:24; -fx-background-color:#ffffff; -fx-background-radius:0 0 10 10;" VBox.vgrow="ALWAYS">
        <Label fx:id="errorLabel" text=""
               style="-fx-text-fill:#EF4444; -fx-font-size:13px; -fx-font-weight:600; -fx-background-color:#FEE2E2; -fx-background-radius:6; -fx-padding:8 12;"
               visible="false" managed="false"/>

        <Label text="DADOS DA FILIAL / LOJA" style="-fx-font-size:11px; -fx-font-weight:700; -fx-text-fill:#475569; -fx-font-family:monospace;"/>
        <GridPane hgap="16" vgap="14">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <children>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Nome do Estabelecimento / Filial *" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                    <TextField fx:id="nameField" promptText="Ex: Loja Central - Maputo"
                               style="-fx-padding:10 12; -fx-background-radius:6; -fx-border-color:#E2E8F0; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="NUIT do Estabelecimento *" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                    <TextField fx:id="nuitField" promptText="Ex: 400123456"
                               style="-fx-padding:10 12; -fx-background-radius:6; -fx-border-color:#E2E8F0; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Contacto / Telefone *" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                    <TextField fx:id="contactField" promptText="Ex: +258 84 999 8888"
                               style="-fx-padding:10 12; -fx-background-radius:6; -fx-border-color:#E2E8F0; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Endereço Físico / Localização *" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                    <TextField fx:id="addressField" promptText="Ex: Av. Eduardo Mondlane, 120"
                               style="-fx-padding:10 12; -fx-background-radius:6; -fx-border-color:#E2E8F0; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                </VBox>
            </children>
        </GridPane>

        <Separator style="-fx-opacity:0.2;"/>
        
        <HBox alignment="CENTER_LEFT">
            <CheckBox fx:id="isHeadCheckbox" text="Esta filial é a Sede Central da Empresa"
                      style="-fx-text-fill:#0F172A; -fx-font-weight:600; -fx-font-size:13px;"/>
        </HBox>

        <Label text="CERTIFICAÇÕES FISCAIS &amp; LICENÇAS" style="-fx-font-size:11px; -fx-font-weight:700; -fx-text-fill:#475569; -fx-font-family:monospace;"/>
        <GridPane hgap="16" vgap="14">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <children>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Nº Certificado Software AT" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                    <TextField fx:id="softwareCertField" promptText="Ex: CERT-AT-2026/0042"
                               style="-fx-padding:10 12; -fx-background-radius:6; -fx-border-color:#E2E8F0; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Nº Alvará / Licença Comercial" style="-fx-font-weight:600; -fx-text-fill:#0F172A; -fx-font-size:12px;"/>
                    <TextField fx:id="licenseField" promptText="Ex: ALV-2026/9821"
                               style="-fx-padding:10 12; -fx-background-radius:6; -fx-border-color:#E2E8F0; -fx-border-radius:6; -fx-font-size:13px; -fx-background-color:#F8FAFC; -fx-text-fill:#0F172A;"/>
                </VBox>
            </children>
        </GridPane>

        <Region VBox.vgrow="ALWAYS"/>
        <Separator style="-fx-opacity:0.2;"/>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button fx:id="cancelButton" text="Cancelar" styleClass="btn-secondary-ux"
                    style="-fx-padding:9 18; -fx-font-size:13px; -fx-background-color:#ffffff; -fx-text-fill:#0F172A; -fx-background-radius:6; -fx-cursor:hand; -fx-font-weight:600; -fx-border-color:#E2E8F0; -fx-border-radius:6;"/>
            <StackPane>
                <Button fx:id="saveButton" text="Guardar Filial" styleClass="btn-primary-ux"
                        style="-fx-padding:9 22; -fx-font-size:13px; -fx-background-color:#2563EB; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:6; -fx-cursor:hand;"/>
                <ProgressIndicator fx:id="saveSpinner" visible="false" managed="false"
                                   style="-fx-progress-color:white; -fx-max-width:22; -fx-max-height:22;"/>
            </StackPane>
        </HBox>
    </VBox>
</VBox>
